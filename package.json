{
  "name": "content-hub",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "configs/*"
    ],
    "catalogs": {
      "test": {
        "@solidjs/testing-library": "0.8.10",
        "@testing-library/jest-dom": "7.0.1",
        "@vitest/coverage-v8": "5.1.0",
        "happy-dom": "21.0.4",
        "vitest": "5.1.0"
      },
      "frontend-dev": {
        "@tailwindcss/vite": "4.3.4",
        "@tanstack/devtools-vite": "0.8.6",
        "@tanstack/router-plugin": "1.168.48",
        "@tanstack/solid-query-devtools": "5.106.1",
        "@tanstack/solid-router-devtools": "1.167.2",
        "tailwindcss": "4.3.4",
        "tw-animate-css": "1.4.0",
        "vite": "8.3.6",
        "vite-plugin-solid": "2.11.15"
      }
    }
  },
  "scripts": {
    "check:type": "turbo run check:type",

